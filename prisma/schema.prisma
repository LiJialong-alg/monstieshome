generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hashed
  role      String   @default("admin") // "admin" | "superadmin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  src         String   @default("")
  tags        String   @default("[]")
  link        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  date      String
  summary   String
  tags      String   @default("[]")
  pinned    Boolean  @default(false)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalLink {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  url         String
  icon        String   @default("Globe")
  category    String   @default("未分类")
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Question {
  id          String   @id @default(cuid())
  scope       String   @default("group") // group | member
  memberId    String   @default("")
  question    String
  image       String   @default("")
  options     String   // JSON array
  answer      Int
  explanation String   @default("")
  difficulty  String   @default("入门")
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, memberId, sortOrder])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  scope     String
  memberId  String   @default("")
  score     Float
  answers   String   @default("[]")
  createdAt DateTime @default(now())

  @@index([scope, memberId, score])
}

model WrongAnswer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption Int
  correctOption  Int
  createdAt      DateTime @default(now())

  @@index([questionId])
}
